# ---------- App ----------
NODE_ENV=development
PORT=9019
LOG_LEVEL=info
APP_URL=http://localhost:9019
FRONTEND_URL=http://localhost:5173
# Extra allowed browser origins, comma-separated
CORS_ORIGINS=
TRUST_PROXY_HOPS=0
TIMEZONE=Africa/Kigali
CURRENCY=RWF

# ---------- Database (MySQL 8) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=njenga
# Managed MySQL (e.g. Aiven) requires TLS. Set DB_SSL_CA to the CA file path to verify the server.
DB_SSL=false
DB_SSL_CA=
DB_POOL_SIZE=10
DB_LOG=false

# ---------- Auth ----------
# At least 32 chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=12h
RESET_TOKEN_EXPIRES_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---------- First Director account (created by npm run db:seed) ----------
SEED_DIRECTOR_NAME=Director
SEED_DIRECTOR_EMAIL=director@njengagreens.local
SEED_DIRECTOR_PASSWORD=Director@2026

# ---------- Email (log | smtp) ----------
MAIL_PROVIDER=log
# Either a well-known service name (e.g. gmail) or host/port
MAIL_SERVICE=
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=NGL Management System <no-reply@njengagreens.local>

# ---------- SMS (log | pindo) ----------
SMS_PROVIDER=log
SMS_API_TOKEN=
SMS_SENDER_ID=NGL

# ---------- File storage (local | cloudinary) ----------
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ngl

# ---------- Background jobs ----------
DISABLE_JOBS=false
